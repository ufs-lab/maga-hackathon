#!/usr/bin/env python3
"""A stand-in for `pnpm`: no registry, no network.

`pnpm [--dir D] install` succeeds. `pnpm [--dir D] exec TOOL ...` and `pnpm [--dir D] TOOL ...`
run TOOL from PATH in D, so `pnpm --dir apps/web exec vite --port 5173 --strictPort` reaches the
`vite` stand-in. `pnpm [run] dev [-- ARGS]` runs `vite ARGS`.
"""
import os
import sys

args = sys.argv[1:]
while args[:1] and args[0] in ("--dir", "-C", "--filter", "-F"):
    if args[0] in ("--dir", "-C"):
        os.chdir(args[1])
    args = args[2:]
if args[:1] == ["--version"]:
    print("9.0.0")
elif args[:1] in (["install"], ["i"], ["add"]) or not args:
    print("Done in 0.1s")
else:
    if args[0] in ("exec", "run", "dlx"):
        args = args[1:]
    if args[:1] == ["dev"]:
        args = ["vite", *[a for a in args[1:] if a != "--"]]
    os.execvp(args[0], args)
